# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by git - never commit a real key.

# Your Anthropic API key (https://platform.claude.com/settings/keys). Server-side only.
ANTHROPIC_API_KEY=

# Optional. Model used by /api/generate. Defaults to claude-haiku-5-5 when empty.
CLAUDE_MODEL=claude-haiku-5-5
